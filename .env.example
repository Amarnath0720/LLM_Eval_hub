# Copy this file to .env. Keys are optional unless you select that provider.
DATABASE_URL=sqlite:///./eval_dashboard.db

# Optional: used when selecting OpenAI models.
OPENAI_API_KEY=

# Optional: used for Gemini generation and the live LLM judge.
GOOGLE_API_KEY=
# GEMINI_API_KEY=  # Alternative name accepted by the Gemini integration.

# Optional: used when selecting Mistral models.
MISTRAL_API_KEY=

# Gemini is the implemented live judge provider; without a Google key,
# the judge uses its deterministic local fallback.
JUDGE_MODEL=gemini-3.6-flash
